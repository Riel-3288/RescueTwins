[basic.config]
cseType = MN
cseID = id-annc-lab-mn
cseName = annc-lab-mn
serviceProviderID = //acme.example.com
adminID = CAdmin
secret = CHANGE_ME_LOCAL_SECRET
networkInterface = 127.0.0.1
cseHost = 127.0.0.1
httpPort = 8011
registrarCseID = id-annc-lab-in
registrarCseName = annc-lab-in
registrarCseHost = 127.0.0.1
registrarCsePort = 8010
databaseType = tinydb
consoleType = simple
consoleTheme = dark
logLevel = info

[cse.registration]
allowedCSROriginators = /id-annc-lab-in

[http]
enableManagementEndpoint = true

[mqtt]
enable = false

[webui]
enable = true
