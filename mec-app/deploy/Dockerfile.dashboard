FROM python:3.13-slim
WORKDIR /workspace/mec-app/deploy
COPY mec-app/deploy/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY mec-app/deploy/rescuetwin ./rescuetwin
COPY mec-app/deploy/tools ./tools
COPY mec-app/deploy/config.team.example.json mec-app/deploy/config.example.json mec-app/deploy/sample-temperature.json ./
COPY mec-app/deploy/dashboard/app.js mec-app/deploy/dashboard/index.html mec-app/deploy/dashboard/style.css mec-app/deploy/dashboard/favicon.svg mec-app/deploy/dashboard/THIRD-PARTY-LICENSES.txt ./dashboard/
COPY simulation/rescue_sim.py simulation/node01_sample.jsonl simulation/sample_data.json simulation/sim_sensor_data.jsonl simulation/sim_agent_log.jsonl /workspace/simulation/
EXPOSE 8765
CMD ["python", "-m", "rescuetwin.demo", "--config", "config.team.example.json", "--recorded-only", "--host", "0.0.0.0"]
